# Copy to .env and fill in. Never commit .env.
# Read by the Node server only. None of these start with VITE_, so none reach the browser bundle.

# Lattice API base, including /api (no trailing slash needed).
LATTICE_API_BASE_URL=http://localhost:8000/api

# Read-only Lattice API key (starts with lat_), created under the organization's API keys in Lattice.
LATTICE_API_KEY=lat_replace_me

# Slug of the content type to read (default: metric-record).
LATTICE_METRIC_CONTENT_TYPE=metric-record

# Optional: which Lattice field plays each role, as JSON. Override only what differs.
# Roles: name, category, value, recordedAt, status, target, unit. Defaults: name, category, value, recorded_at, status, target, unit.
# LATTICE_FIELD_MAP={"recordedAt":"logged_on"}

# Explicit demo mode: serves a built-in, clearly labelled fixture and never contacts Lattice. Needs no key.
# It is never used as a fallback when Lattice fails. Leave unset/false for real data.
# ANALYTICS_DEMO_MODE=true

# Node server port (API + built UI). The Vite dev server (3003) proxies /api here.
PORT=3004

# How long /api/records may serve a cached Lattice response, in seconds.
RECORDS_CACHE_TTL_SECONDS=30

# How often the browser re-checks for new data, in seconds (minimum 15). Lattice allows 60 requests/min per key.
ANALYTICS_REFRESH_INTERVAL_SECONDS=60
